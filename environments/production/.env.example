# Copy to .env on the production VM and fill every blank. .env is never committed.
# Generate each secret with: openssl rand -hex 24
#
# Never reuse a staging value here. Same password in two environments means a
# staging leak is a production breach.

# ── Release ──────────────────────────────────────────────────────────────────
# The exact image version this environment runs. Rewritten by the deploy
# workflow on every release; never `latest` (ADR-009).
IMAGE_TAG=

# ── API exposure ─────────────────────────────────────────────────────────────
# The interface and host port the API is published on. Keep it on 127.0.0.1 with
# a reverse proxy terminating TLS in front (proxy/production.conf). 0.0.0.0 would
# serve plain HTTP to the internet.
#
# If production shares a machine with another environment, give it a port that
# environment does not use and set the HEALTH_URL variable on the GitHub
# Environment to match — the deploy's health check defaults to port 8080.
API_BIND=127.0.0.1
API_PORT=8080

# ── Datastores ───────────────────────────────────────────────────────────────
# These publish no host ports. Only this project's containers reach them, and
# the connection strings are assembled in docker-compose.yml.
POSTGRES_USER=ragenta
POSTGRES_PASSWORD=
POSTGRES_DB=ragenta
REDIS_PASSWORD=
MINIO_ROOT_USER=ragenta
# Minimum 8 characters or the container refuses to start.
MINIO_ROOT_PASSWORD=
QDRANT_API_KEY=

# ── Application runtime (passed into api and worker) ─────────────────────────
NODE_ENV=production
PORT=8080

# Public URL of this API. Better Auth builds callback and reset links from it.
API_BASE_URL=https://api.ragenta.com
# Frontend origin. Used in invitation and password-reset emails.
APP_BASE_URL=https://app.ragenta.com
# Extra CORS origins, comma separated.
TRUSTED_ORIGINS=

# Min 32 chars. Generate with: openssl rand -base64 48
# Rotating this signs every live session out — treat it as a scheduled action.
BETTER_AUTH_SECRET=
# Shares the session cookie across subdomains, e.g. ragenta.com.
AUTH_COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI providers ─────────────────────────────────────────────────────────────
# Ragenta pays for inference, so these are server secrets. A provider without a
# key here is hidden from every model picker.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Stripe (both key and webhook secret required to enable payments) ─────────
# Live keys, not test keys — and the webhook secret must come from the endpoint
# registered against this API's public URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_TOPUP_1M=
STRIPE_PRICE_TOPUP_5M=
STRIPE_PRICE_TOPUP_15M=

# ── Email ────────────────────────────────────────────────────────────────────
# Unset SMTP_HOST logs mails instead of sending them, which in production means
# invitations and password resets silently never arrive.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ragenta.com
SMTP_FROM_NAME=Ragenta

# ── Docs ─────────────────────────────────────────────────────────────────────
# Off in production: the OpenAPI document maps every route and DTO.
DOCS_ENABLED=false

# ── Platform admin ───────────────────────────────────────────────────────────
# Comma-separated user ids that always pass the admin gate, regardless of role.
ADMIN_USER_IDS=
