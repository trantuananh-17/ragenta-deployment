# Copy to .env on the production VM and fill every blank. .env is never committed.
# Generate each secret with: openssl rand -hex 24
#
# Never reuse a staging value here. Same password in two environments means a
# staging leak is a production breach.

# ── Release ──────────────────────────────────────────────────────────────────
# One variable per deployable, each rewritten only by that repository's own
# deploy. A shared name would mean releasing the frontend silently moves the
# backend to the frontend's version.
#
# Do not set these by hand — the deploy workflow writes them, and a value typed
# here is either ignored or, worse, the wrong build. Never `latest` (ADR-009).
#
# Add a line when its repository gains a service in docker-compose.yml:
#   IMAGE_TAG_LANDINGPAGE, IMAGE_TAG_APP, IMAGE_TAG_ADMIN, …
IMAGE_TAG_BACKEND=
IMAGE_TAG_LANDING_PAGE=
IMAGE_TAG_CONTENT_BACKEND=
IMAGE_TAG_ADMIN_FRONTEND=

# ── API exposure ─────────────────────────────────────────────────────────────
# The interface and host port the API is published on. Keep it on 127.0.0.1 with
# a reverse proxy terminating TLS in front (proxy/production.conf). 0.0.0.0 would
# serve plain HTTP to the internet.
#
# If production shares a machine with another environment, give it a port that
# environment does not use and set the HEALTH_URL variable on the GitHub
# Environment to match — the deploy's health check defaults to port 8080.
API_BIND=127.0.0.1
API_PORT=8080

# ── Landing page exposure ────────────────────────────────────────────────────
# The marketing site's loopback port. nginx proxies the public hostname to it
# (proxy/production.conf). 8081 is reserved for this app in docs/vm-access.md.
LANDING_BIND=127.0.0.1
LANDING_PORT=8081

# ── Admin console exposure ───────────────────────────────────────────────────
# The internal admin console's loopback port. nginx proxies
# admin-frontend.ragenta.cloud to it (proxy/production.conf). 8083 is reserved
# for this app in docs/vm-access.md.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8083
# The console's own public origin. Better Auth builds the Google OAuth callback
# from it, so a wrong value does not degrade sign-in — it breaks it. It must
# also appear in TRUSTED_ORIGINS below, or the backend refuses the session.
ADMIN_BASE_URL=https://admin-frontend.ragenta.cloud

# ── Content backend exposure ─────────────────────────────────────────────────
# The content API's loopback port. nginx proxies
# content-backend.ragenta.cloud to it (proxy/production.conf), for the
# admin editing surface. The landing page is
# deliberately not moved onto that hostname — it keeps reading this service
# over the project network (RAGENTA_CONTENT_API_URL below).
# 8084 is reserved for this app in docs/vm-access.md.
CONTENT_BIND=127.0.0.1
CONTENT_PORT=8084
# Only the `servers` entry in /v1/docs is built from this, and DOCS_ENABLED is
# off here — but it must still be the hostname proxy/production.conf serves, so
# turning the docs on for an hour does not hand out a loopback URL.
CONTENT_PUBLIC_URL=https://content-backend.ragenta.cloud

# ── Landing page runtime ─────────────────────────────────────────────────────
# Read at request time, not baked into the image, so one build serves any
# environment. The landing container gets these four and nothing else — it is
# the most exposed container here and needs no secret from the rest of .env.
#
# The apex, not a named host: every other service here is the repository name
# without the ragenta- prefix, but the marketing site is what a person types.
# www.ragenta.cloud redirects here in nginx, so this value must stay the apex or
# every canonical URL points at the hostname that redirects away.
SITE_URL=https://ragenta.cloud

# Where the contact form posts. Unset means /api/contact answers 503.
CONTACT_WEBHOOK_URL=

# Unset means PostHog is not loaded in the browser at all.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# The content backend, over this project's network — not through nginx. The
# landing page reads it server-side, so an internal hostname saves a public
# round trip on every revalidation and keeps working if the proxy is down.
#
# Unset means the site serves its bundled fixtures for the catalogue, blog,
# changelog, announcement bar and legal pages. So does the content backend
# being unreachable: `fromApi` turns any failure into that same fallback, which
# is why `landing` has no depends_on for it.
RAGENTA_CONTENT_API_URL=http://content:8084
# ── Datastores ───────────────────────────────────────────────────────────────
# These publish no host ports. Only this project's containers reach them, and
# the connection strings are assembled in docker-compose.yml.
POSTGRES_USER=ragenta
POSTGRES_PASSWORD=
POSTGRES_DB=ragenta
REDIS_PASSWORD=
MINIO_ROOT_USER=ragenta
# Minimum 8 characters or the container refuses to start.
MINIO_ROOT_PASSWORD=
QDRANT_API_KEY=

# ── Application runtime (passed into api and worker) ─────────────────────────
NODE_ENV=production
PORT=8080

# Public URL of this API. Better Auth builds callback and reset links from it.
API_BASE_URL=https://backend.ragenta.cloud
# Frontend origin. Used in invitation and password-reset emails.
APP_BASE_URL=https://frontend.ragenta.cloud
# Browser origins allowed to call this API with credentials, comma separated.
# Every production origin has to be listed: the code carries no *.ragenta.cloud
# default, because that pattern also matches staging-*.ragenta.cloud — a staging
# page could then act as a signed-in production user.
TRUSTED_ORIGINS=https://frontend.ragenta.cloud,https://admin-frontend.ragenta.cloud,https://ragenta.cloud

# Min 32 chars. Generate with: openssl rand -base64 48
# Rotating this signs every live session out — treat it as a scheduled action.
BETTER_AUTH_SECRET=
# Leave empty. The only Domain value that would span the production hostnames is
# ragenta.cloud, and staging lives under that same registrable domain — a
# production session cookie would then be sent to the staging VM (ADR-010).
# Host-only cookies plus TRUSTED_ORIGINS above are what production uses instead.
AUTH_COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Secrets at rest ──────────────────────────────────────────────────────────
# 32 bytes of base64, from `openssl rand -base64 32`. Encrypts the provider API
# keys stored through the admin console. Without it the stack still runs on the
# environment keys below, but saving one through the console is refused —
# writing a secret in the clear because a key was missing is not a fallback.
#
# Rotating this value orphans every stored credential: they decrypt with the old
# key and nothing else. Re-enter them in the console after a rotation.
SECRETS_ENCRYPTION_KEY=

# ── AI providers ─────────────────────────────────────────────────────────────
# Ragenta pays for inference, so these are server secrets. A provider without a
# key here is hidden from every model picker.
#
# These are the FALLBACK now. A `provider_credential` row written through the
# admin console wins over the value here, because that one can be rotated
# without a redeploy. Keep these as the bootstrap key, or for a deployment with
# no SECRETS_ENCRYPTION_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Stripe (both key and webhook secret required to enable payments) ─────────
# Live keys, not test keys — and the webhook secret must come from the endpoint
# registered against this API's public URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_TOPUP_1M=
STRIPE_PRICE_TOPUP_5M=
STRIPE_PRICE_TOPUP_15M=

# ── Email ────────────────────────────────────────────────────────────────────
# Unset SMTP_HOST logs mails instead of sending them, which in production means
# invitations and password resets silently never arrive.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ragenta.cloud
SMTP_FROM_NAME=Ragenta

# ── Docs ─────────────────────────────────────────────────────────────────────
# Off in production: the OpenAPI document maps every route and DTO.
DOCS_ENABLED=false

# ── Platform admin ───────────────────────────────────────────────────────────
# Comma-separated user ids that always pass the admin gate, regardless of role.
ADMIN_USER_IDS=
