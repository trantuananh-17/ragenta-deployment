# Copy to .env on the VM and fill every blank. .env is never committed.
# Generate each secret with: openssl rand -base64 32

# ── Network exposure ─────────────────────────────────────────────────────────
# Interface the published ports bind to on the VM.
#   127.0.0.1  reachable only through an SSH tunnel — the default, and the only
#              safe option on a VM with a public IP
#   0.0.0.0    reachable on the VM's IP directly; only do this behind a firewall
#              that allowlists your own address, and keep every password below
BIND_ADDRESS=127.0.0.1

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=ragenta
POSTGRES_PASSWORD=
POSTGRES_DB=ragenta
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
# Redis has no authentication unless a password is set, so this is required.
REDIS_PASSWORD=
REDIS_PORT=6379

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=ragenta
# Minimum 8 characters or the container refuses to start.
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Qdrant ───────────────────────────────────────────────────────────────────
# Qdrant is unauthenticated without this key.
QDRANT_API_KEY=
QDRANT_PORT=6333
